[
  {"q": "A comrade is injured during a Titan retreat. Carrying them slows you down by 40%.", "opts": {"Leave them to ensure squad survival.": {"L": 1.5, "E": -1.5}, "Carry them. We all go home or nobody does.": {"E": 1.5, "L": -1.5, "O": 0.5}}},
  {"q": "You discover a classified document proving the government is lying about the Titans.", "opts": {"Leak it to the public immediately.": {"F": 1.5, "O": -2.0}, "Bring it to your commander in secret.": {"O": 1.5, "F": -1.0}, "Study the documents to understand the enemy first.": {"C": 1.5, "A": -0.5}}},
  {"q": "A captured enemy soldier was brainwashed as a child to hate your people.", "opts": {"They are still an enemy combatant. Execute.": {"L": 1.0, "E": -1.5, "A": 1.0}, "Interrogate them for tactical information.": {"C": 1.0, "A": 0.5}, "Show them mercy to break the cycle of hatred.": {"E": 2.0, "A": -1.5}}},
  {"q": "Your squad leader gives an order that will result in a 90% casualty rate for a strategic win.", "opts": {"Follow the order without hesitation.": {"O": 2.0, "F": -1.0}, "Refuse the order and try to find another way.": {"F": 1.5, "O": -2.0}, "Accept the grim mathematics. It's necessary.": {"L": 1.5, "E": -1.0}}},
  {"q": "How do you view the Titans?", "opts": {"Monsters that need to be eradicated from the earth.": {"A": 2.0, "C": -1.0}, "A fascinating biological mystery waiting to be solved.": {"C": 2.0, "A": -1.0}, "Tragic victims of a cruel history.": {"E": 1.5, "A": -1.0}}},
  {"q": "During training, what was your primary motivation?", "opts": {"To become strong enough to go beyond the walls.": {"F": 1.5, "A": 0.5}, "To earn a comfortable life in the Interior Police.": {"L": 1.0, "F": -1.0}, "To protect my family and friends.": {"E": 1.5, "O": 0.5}}},
  {"q": "An abnormal Titan is behaving erratically, ignoring humans and staring at a wall.", "opts": {"Kill it immediately before it changes its mind.": {"A": 1.5, "C": -1.5}, "Observe it. Document its behavior.": {"C": 2.0, "A": -1.0}, "Set a trap and capture it alive.": {"C": 1.0, "L": 1.0}}},
  {"q": "To win a war, is it acceptable to sacrifice innocent civilians on the enemy side?", "opts": {"Yes. War is absolute.": {"L": 2.0, "E": -2.0, "A": 1.0}, "No. That makes us no better than them.": {"E": 2.0, "L": -1.5}}},
  {"q": "You are surrounded by Titans. Your gas is almost empty.", "opts": {"Fight to the very last breath.": {"A": 1.5, "F": 1.0}, "Conserve gas, hide, and wait for rescue.": {"L": 1.5, "A": -1.5}, "Give your remaining gas to the fastest scout so they can escape.": {"E": 1.5, "L": 0.5}}},
  {"q": "What is true freedom?", "opts": {"The power to crush anyone who tries to cage you.": {"F": 2.0, "A": 1.5, "E": -1.0}, "The ability to choose your own death.": {"F": 1.0, "L": 1.0}, "A world without walls or enemies.": {"E": 1.0, "F": 1.0}}},
  {"q": "Your closest friend is revealed to be an enemy spy.", "opts": {"Kill them yourself.": {"A": 1.5, "L": 1.0, "E": -2.0}, "Try to understand why they did it.": {"E": 1.5, "C": 1.0, "A": -1.5}, "Arrest them and let the military tribunals decide.": {"O": 2.0, "F": -1.0}}},
  {"q": "A wealthy merchant is blocking the evacuation gate with his cargo.", "opts": {"Order him to move it, using force if necessary.": {"A": 1.0, "O": 1.0}, "Kill him. He's endangering thousands.": {"L": 1.5, "A": 1.5, "E": -2.0}, "Try to reason with him to buy time.": {"E": 1.0, "A": -1.0}}},
  {"q": "You find a mysterious serum that could turn someone into a Titan.", "opts": {"Destroy it. It's too dangerous.": {"O": 1.0, "C": -2.0}, "Study its chemical composition.": {"C": 2.0, "L": 0.5}, "Keep it secret as a last resort weapon.": {"L": 1.5, "O": -1.5}}},
  {"q": "What makes a good leader?", "opts": {"The ability to make the ruthless choices no one else will.": {"L": 2.0, "E": -1.0}, "Inspiring absolute loyalty and trust in their subordinates.": {"O": 1.5, "E": 1.0}, "Leading the charge from the front lines.": {"A": 1.5, "L": -0.5}}},
  {"q": "You uncover a plot to overthrow the King.", "opts": {"Report the traitors to the Military Police.": {"O": 2.0, "F": -1.0}, "Join the rebellion to shatter the stagnant system.": {"F": 2.0, "O": -2.0}, "Wait and see which side is more likely to win.": {"L": 2.0, "O": -1.0}}},
  {"q": "When staring at the ocean for the first time, what do you feel?", "opts": {"Disappointment. Our enemies are on the other side.": {"A": 1.5, "F": 1.0}, "Awe. The world is so much bigger than the walls.": {"C": 1.5, "E": 1.0}, "Relief. We finally made it.": {"E": 1.0, "A": -1.0}}},
  {"q": "A scout is paralyzed by fear and refuses to advance.", "opts": {"Leave them behind. They are a liability.": {"L": 1.5, "E": -1.5}, "Threaten them to get them moving.": {"A": 1.5, "O": 1.0}, "Comfort them and remind them of their purpose.": {"E": 2.0, "L": -1.0}}},
  {"q": "What is the most valuable weapon against the Titans?", "opts": {"Information and research.": {"C": 2.0, "A": -1.0}, "Raw physical strength and ODM skill.": {"A": 2.0, "L": -1.0}, "Strategic planning and formations.": {"L": 1.5, "O": 1.0}}},
  {"q": "You have to choose one person to inherit a Titan power. Who gets it?", "opts": {"The smartest tactician.": {"L": 1.5, "C": 1.0}, "The most loyal soldier.": {"O": 2.0, "F": -1.0}, "The person with the strongest will to live.": {"F": 1.5, "A": 1.0}}},
  {"q": "Do you believe humanity is inherently good or evil?", "opts": {"Evil. People will always fight each other.": {"L": 1.0, "E": -1.0}, "Good. Circumstances force people to do terrible things.": {"E": 1.5, "L": -1.0}, "Neither. We are just animals fighting to survive.": {"F": 1.0, "C": 1.0}}},
  {"q": "A new, highly advanced weapon is invented. It's brutally effective but causes immense suffering.", "opts": {"Mass produce it. Victory at any cost.": {"L": 2.0, "E": -2.0}, "Refuse to use it on moral grounds.": {"E": 2.0, "L": -1.5}, "Study it to see if the technology can be adapted safely.": {"C": 1.5, "A": -0.5}}},
  {"q": "You have a day off in the Trost District. What do you do?", "opts": {"Train alone. There is no time to rest.": {"A": 1.5, "E": -1.0}, "Read books about the outside world.": {"C": 2.0, "O": -0.5}, "Drink and celebrate with your squad.": {"E": 1.5, "L": -1.0}}},
  {"q": "If you could erase the existence of Titans entirely by sacrificing your own life, would you?", "opts": {"Without hesitation.": {"E": 1.5, "O": 1.0}, "No. My life is my own.": {"F": 2.0, "E": -1.0}, "Only if it statistically guaranteed the survival of Paradis.": {"L": 2.0, "F": -0.5}}},
  {"q": "A commander demands you hand over a comrade to be tortured for information.", "opts": {"Comply. The chain of command is absolute.": {"O": 2.0, "E": -2.0}, "Refuse and fight the commander.": {"F": 2.0, "O": -2.0, "A": 1.0}, "Try to negotiate a different interrogation method.": {"L": 1.0, "E": 1.0}}},
  {"q": "What scares you more?", "opts": {"Being trapped forever without choices.": {"F": 2.0, "O": -1.0}, "Being responsible for the deaths of my friends.": {"E": 2.0, "L": -1.0}, "The unknown nature of the world.": {"C": -1.0, "O": 1.0}}},
  {"q": "In a 1v1 fight against a stronger opponent, what is your strategy?", "opts": {"Overwhelm them with speed and aggression.": {"A": 2.0, "L": -0.5}, "Analyze their movements and exploit a weakness.": {"L": 1.5, "C": 1.0}, "Endure their hits until they tire out.": {"O": 1.5, "A": -1.0}}},
  {"q": "You are offered a position in the corrupt but safe Military Police.", "opts": {"Take it. Survival is the logical choice.": {"L": 1.5, "F": -1.0}, "Refuse. I belong on the front lines.": {"A": 1.5, "L": -1.0}, "Take it to dismantle the corruption from the inside.": {"C": 1.0, "F": 1.0}}},
  {"q": "A child steals your rations because they are starving.", "opts": {"Let them have it.": {"E": 2.0, "L": -1.0}, "Take it back by force. It's a harsh world.": {"L": 1.0, "A": 1.0, "E": -1.5}, "Report them to the authorities.": {"O": 1.5, "E": -1.0}}},
  {"q": "What is your stance on preemptive strikes?", "opts": {"Necessary. Strike before they can strike us.": {"A": 2.0, "L": 1.0}, "Wrong. We should only fight in defense.": {"E": 1.5, "A": -2.0}}},
  {"q": "You find a beautiful flower growing in a battlefield.", "opts": {"Ignore it. It's irrelevant to the mission.": {"L": 1.5, "C": -1.0}, "Pause to appreciate it.": {"E": 1.5, "A": -1.0}, "Examine how it survived the destruction.": {"C": 2.0, "L": -0.5}}},
  {"q": "Your squad is arguing about the best route through a forest.", "opts": {"Impose your decision to save time.": {"A": 1.0, "O": 1.0}, "Listen to all sides and calculate the safest path.": {"L": 1.5, "E": 0.5}, "Let the highest-ranking officer decide.": {"O": 2.0, "F": -1.0}}},
  {"q": "A Titan is ignoring a village and heading for a military base.", "opts": {"Let it go. The military can handle it.": {"L": 1.5, "E": -1.0}, "Engage it immediately to protect the base.": {"A": 1.5, "O": 1.0}, "Follow it to study its abnormal pathing.": {"C": 2.0, "A": -1.0}}},
  {"q": "Do you believe the ends justify the means?", "opts": {"Always.": {"L": 2.0, "E": -1.5}, "Never.": {"E": 2.0, "L": -2.0}, "Only if the ends secure our freedom.": {"F": 2.0, "L": 0.5}}},
  {"q": "You are captured by the enemy. What do you do?", "opts": {"Bite your tongue and fight to the death.": {"A": 2.0, "F": 1.0}, "Lie and manipulate them to orchestrate an escape.": {"L": 1.5, "C": 1.0}, "Accept your fate silently.": {"O": 1.5, "F": -2.0}}},
  {"q": "What is the purpose of the Survey Corps?", "opts": {"To eradicate the Titans.": {"A": 2.0, "C": -1.0}, "To discover the truth of the world.": {"C": 2.0, "A": -1.0}, "To serve as the King's vanguard.": {"O": 2.0, "F": -1.5}}},
  {"q": "A comrade suggests deserting the military to live peacefully in the mountains.", "opts": {"Arrest them for treason.": {"O": 2.0, "E": -1.5}, "Join them. I want to be free of this war.": {"F": 2.0, "O": -2.0}, "Convince them to stay. We need every soldier.": {"E": 1.5, "L": 0.5}}},
  {"q": "You witness a superior officer taking a bribe.", "opts": {"Blackmail them for better equipment.": {"L": 2.0, "O": -1.5}, "Report them immediately.": {"O": 2.0, "L": -1.0}, "Ignore it. It's not my problem.": {"F": 1.0, "E": -1.0}}},
  {"q": "How do you handle grief?", "opts": {"Turn it into rage against the enemy.": {"A": 2.0, "E": -1.0}, "Bury it deep and focus on the mission.": {"L": 1.5, "O": 1.0}, "Lean on your friends for support.": {"E": 2.0, "L": -1.0}}},
  {"q": "What is your greatest strength?", "opts": {"My unyielding willpower.": {"F": 2.0, "A": 1.0}, "My tactical intellect.": {"L": 2.0, "C": 1.0}, "My dedication to my comrades.": {"E": 1.5, "O": 1.5}}},
  {"q": "If you reach the basement, what do you hope to find?", "opts": {"A weapon to destroy our enemies.": {"A": 2.0, "E": -1.0}, "The true history of the world.": {"C": 2.0, "A": -0.5}, "Proof that we are not alone.": {"E": 1.5, "C": 1.0}}}
]
